# A warm cup by a rainy window. A cookie shows up when Claude uses a tool.
name: coffee
caption: a warm cup of coffee
size: 34x4

[palette]
w = #e8f4ff
r = #7fa8d6
b = #c8a27a

[particles rain]
glyphs: ' ,
count: 6
motion: fall
speed: 2.5
